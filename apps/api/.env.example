# ==========================================
# R-zension API Environment Configuration
# ==========================================

# Server & Environment
NODE_ENV=development
PORT=4000
HOST=0.0.0.0
API_PREFIX=/api/v1

# Logging & CORS
LOG_LEVEL=info
CORS_ORIGIN=*

# Database (Placeholder Configuration)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/rzension_db?schema=public

# AI Service (Placeholder Configuration)
AI_SERVICE_URL=http://localhost:8000

# Security (Placeholder Configuration — Min 32 chars)
JWT_SECRET=rzension_jwt_secret_development_placeholder_key_min32chars
JWT_EXPIRES_IN=1d

# Email (Placeholder Configuration)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=user@example.com
SMTP_PASS=password

# Storage (Placeholder Configuration)
STORAGE_PROVIDER=local
STORAGE_BUCKET=rzension-storage
